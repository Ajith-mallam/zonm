DATABASE_URL=postgresql://zonm:zonm_dev_password@localhost:5432/zonm
REDIS_URL=redis://localhost:6379
ENGINE_URL=http://localhost:8000
AUTH_SECRET=change-me
# 32 random bytes, base64. Encrypts TOTP secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
APIFY_TOKEN=

# End-to-end tests (npm run test:e2e)
# E2E_BASE_URL=http://localhost:3100
# PLAYWRIGHT_BROWSERS_PATH=   # folder holding the Playwright headless shell

# Sign-in security switches (both default to true). Set to false only for local
# testing: AUTH_MFA_REQUIRED=false gives password-only sign-in with a warning
# banner; AUTH_FORCE_PASSWORD_CHANGE=false skips the temporary-password change.
# AUTH_MFA_REQUIRED=true
# AUTH_FORCE_PASSWORD_CHANGE=true
