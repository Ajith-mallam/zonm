DATABASE_URL=postgresql://zonm:zonm_dev_password@localhost:5432/zonm
# Direct (unpooled) connection for migrations; same as DATABASE_URL locally.
DATABASE_URL_UNPOOLED=postgresql://zonm:zonm_dev_password@localhost:5432/zonm
REDIS_URL=redis://localhost:6379
ENGINE_URL=http://localhost:8000
AUTH_SECRET=change-me
# 32 random bytes, base64. Encrypts TOTP secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
# Apify API token for social media capture (Apify Console -> Settings -> API & Integrations).
APIFY_TOKEN=

# End-to-end tests (npm run test:e2e)
# E2E_BASE_URL=http://localhost:3100
# PLAYWRIGHT_BROWSERS_PATH=   # folder holding the Playwright headless shell

# Sign-in security switches (both default to true). Set to false only for local
# testing: AUTH_MFA_REQUIRED=false gives password-only sign-in with a warning
# banner; AUTH_FORCE_PASSWORD_CHANGE=false skips the temporary-password change.
# AUTH_MFA_REQUIRED=true
# AUTH_FORCE_PASSWORD_CHANGE=true
# 32 random bytes, base64. Encrypts stored evidence files (generate like MFA_ENCRYPTION_KEY).
STORAGE_ENCRYPTION_KEY=
# Where evidence files are stored (default: apps/web/storage).
# STORAGE_DIR=
# AUTH_TEST_MODE_BANNER=true   # warning banner while MFA is off (default true)

# Reverse proxies in front of the app that append to X-Forwarded-For (1 behind
# Nginx with proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for).
# 0 = no trusted proxy: forwarding headers are ignored and audit IPs are blank.
TRUSTED_PROXY_HOPS=0
